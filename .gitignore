# Local reference checkouts (independent upstream repositories; see README).
/CEBRA/
/CPC_audio_reference/
/SoftCLT/

# Raw datasets are recoverable from the documented upstream sources.
# Keep them locally; never add the ~700 MB data bundle to this repository.
/data/

# Generated fits, checkpoints, embeddings and per-run metrics stay local.
# The reviewed, lightweight paper-figure delivery is versioned separately.
/results/*
!/results/PAPER_FIGURE_DELIVERY/
# High-resolution PDF exports duplicate the published PNGs and remain local.
/results/PAPER_FIGURE_DELIVERY/**/*.pdf

# Figure 2 reproduction: keep runnable scripts and reports, not fit artifacts.
/reproduction/figure2_bc/*
!/reproduction/figure2_bc/scripts/
!/reproduction/figure2_bc/*.md

# Personal/reference-library material is not needed to run the code.
/Ref Bib/

# Local progress notes and research scratchpads; keep protocol and README.
/STATUS.md
/TODO.md
/WORKLOG_DETAILED.md
/RESEARCH_IDEAS_FROM_CEBRA.md

# One-off repository-maintenance utility, not part of experiment reproduction.
/cebra_replica/archive/

# Published HDF5 figure-reference containers; keep local, do not push.
/cebra_replica/monkey/official_reference/Figure3.h5
/cebra_replica/monkey/official_reference/EDFigure8.h5

# Python environments and transient files.
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/
.env
.DS_Store
Thumbs.db
